pipeline {
    agent any

    environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-21.0.11'
        PATH = "${JAVA_HOME}\\bin;C:\\Program Files\\apache-maven-3.9.12\\bin;${env.PATH}"
    }

    stages {
        stage('Build') {
            steps {
                dir('Snake Game/mvn/Maven') {
                    bat 'mvn clean package'
                }
            }
        }

        stage('Run') {
            steps {
                dir('Snake Game/mvn/Maven') {
                    bat 'java -jar target\\Maven1-1.0-SNAPSHOT.jar'
                }
            }
        }
    }
}
